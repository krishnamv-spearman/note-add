{
  "name": "note-add",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sticky-note expense pages that add themselves up. An offline-first PWA by Spearman.",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/caladea": "5.3.0",
    "@fontsource/carlito": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/work-sans": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.11.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,md,yml,html}": [
      "prettier --write"
    ]
  }
}
